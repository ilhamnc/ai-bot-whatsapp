# Pilih provider: gemini atau openai.
AI_PROVIDER=gemini
AI_API_KEY=isi_api_key_di_sini
AI_MODEL=gemini-3.5-flash-lite
# Model alternatif dipisahkan koma. Boleh kosongkan jika tidak ingin fallback.
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# Untuk provider OpenAI-compatible, misalnya API OpenAI atau endpoint kompatibel.
# AI_PROVIDER=openai
# AI_API_KEY=isi_api_key_provider
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_FALLBACK_MODELS=gpt-4o-mini

# Variabel GEMINI_API_KEY, GEMINI_MODEL, dan GEMINI_FALLBACK_MODELS lama masih didukung.
# Jangan unggah kunci API ke GitHub.

# Jalankan bot sekali, ketik !idgrup di grup, lalu salin ID dari terminal.
WA_GROUP_ID=

# MAX_MODEL_PER_REQUEST=3

# ID operator dari perintah !myid, dipisahkan koma bila lebih dari satu.
BOT_ADMIN_IDS=
# Opsional bila mention akun bot memakai ID lain.
# BOT_MENTION_IDS=

# Opsional untuk server. Simpan kedua direktori pada disk yang persisten.
# BOT_STATE_DIR=/home/ubuntu/bot-data/state
# WA_AUTH_DIR=/home/ubuntu/bot-data/auth
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_NO_SANDBOX=1
