# Provider utama dan fallback diatur berurutan. Groq menjadi utama; Gemini dipakai
# ketika kuota/model Groq gagal atau untuk gambar bila kandidat sebelumnya tidak mendukung vision.
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# Kunci enkripsi data lokal: 32 byte acak dalam Base64. Jangan commit atau kirim ke chat.
# Generate dengan: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Urutan utama → fallback; hanya model yang sesuai permintaan gambar yang dicoba untuk gambar.
AI_MODEL_ORDER=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash,gemini:gemini-2.5-flash-lite,gemini:gemini-3.8-flash,gemini:gemini-3.7-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,groq:allam-2-7b
# Opsional provider OpenAI-compatible.
# AI_PROVIDER=openai
# OPENAI_API_KEY=isi_api_key_provider
# AI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Untuk konfigurasi satu-provider lama, AI_API_KEY dan AI_MODEL masih didukung.
# Konfigurasi Groq + Gemini perlu GROQ_API_KEY dan GEMINI_API_KEY terpisah.
# Jangan unggah kunci API ke GitHub.

# Opsional: target grup awal untuk instalasi lama. Untuk pemasangan baru,
# cukup ketik !idgrup di grup; pilihan tersimpan dan dapat dikunci di dashboard.
WA_GROUP_ID=

# ID operator dari perintah !myid, dipisahkan koma bila lebih dari satu.
BOT_ADMIN_IDS=
# Opsional bila mention akun bot memakai ID lain.
# BOT_MENTION_IDS=

# Opsional untuk server. Simpan kedua direktori pada disk yang persisten.
# BOT_STATE_DIR=/home/ubuntu/bot-data/state
# WA_AUTH_DIR=/home/ubuntu/bot-data/auth

# Port dashboard reminder lokal (default 3030, hanya bind ke 127.0.0.1).
# DASHBOARD_PORT=3030
# Untuk hosting container, isi ketiganya. Buat password panjang dan unik.
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=isi_password_yang_panjang
